#!/usr/bin/env bash
set -euo pipefail

_resolve_script_dir() {
  local src="$0"
  while [ -L "$src" ]; do
    local dir
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    case "$src" in /*) ;; *) src="$dir/$src" ;; esac
  done
  cd -P "$(dirname "$src")" && pwd
}

SCRIPT_DIR="$(_resolve_script_dir)"

usage() {
  cat <<'USAGE'
Usage: hagency <command> [args]

Core:
  up             Start or resume an agent
  down           Stop an agent
  ls             List agents
  send           Send message to target pane
  update         Update/install hagency-legacy runtime
  service        Control local/remote services
  verify-remote  Verify remote relay + MCP + agent status

Ops:
  maintain       Rotate logs and prune stale tmp files
  prune-agents   Prune stale offline agent records from backend
  reminder       Schedule/check reminders

Admin:
  cli            Backend/group/admin helper CLI

Compatibility notes:
  Legacy commands (hagency-up, hagency-down, hagency-send, ...) are deprecated and
  will forward to this unified entrypoint.
USAGE
}

dispatch() {
  local target="$1"
  shift
  local target_path="$SCRIPT_DIR/$target"
  if [ ! -x "$target_path" ]; then
    echo "Error: command target '$target' is not available in this remote package." >&2
    echo "Expected executable: $target_path" >&2
    exit 127
  fi
  HAGENCY_INTERNAL_DISPATCH=1 exec "$target_path" "$@"
}

if [ $# -lt 1 ]; then
  usage
  exit 1
fi

cmd="$1"
shift

case "$cmd" in
  up) dispatch "hagency-up" "$@" ;;
  down) dispatch "hagency-down" "$@" ;;
  ls|list) dispatch "hagency-ls" "$@" ;;
  send) dispatch "hagency-send" "$@" ;;
  update) dispatch "hagency-update" "$@" ;;
  service) dispatch "hagency-service" "$@" ;;
  verify-remote|verify) dispatch "verify-remote" "$@" ;;
  maintain) dispatch "hagency-maintain" "$@" ;;
  prune-agents) dispatch "hagency-prune-agents" "$@" ;;
  reminder|self-time-reminder) dispatch "self-time-reminder" "$@" ;;
  cli|admin) dispatch "hagency-cli" "$@" ;;
  -h|--help|help) usage ;;
  *)
    echo "Error: unknown or unsupported remote command '$cmd'" >&2
    usage >&2
    exit 1
    ;;
esac
